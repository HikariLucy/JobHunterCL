# Copia este archivo como .env solo si necesitas cambiar los valores por defecto.
# JobHunter no lee secretos: no pongas aquí contraseñas de portales de empleo.

# Carpeta de datos privados (SQLite, perfil, respaldos). Por defecto: ./data
# JOBHUNTER_DATA_DIR=C:\Users\tu_usuario\JobHunterData

# Puerto local del panel (siempre escucha en 127.0.0.1). Por defecto: 8765
# JOBHUNTER_PORT=8765

# 0 desactiva el programador de búsquedas aunque haya un intervalo configurado.
# JOBHUNTER_SCHEDULER=1
